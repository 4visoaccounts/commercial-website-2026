{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set id = data.commonId ?? "" %}
{% set title = data.commonTitle ?? "" %}
{% set description = data.commonDescription ?? "" %}
{% set blocks = data.commonBlocks.all() ?? [] %}
{% set spacing = data.commonSpacing ?? "default" %}
{% if spacing == "small" %}
    {% set spacingClass = "py-8 md:py-16" %}
{% elseif spacing == "smallTopDefaultBottom" %}
    {% set spacingClass = "pt-8 md:pt-16 pb-16 md:pb-32" %}
{% elseif spacing == "smallBottomDefaultTop" %}
    {% set spacingClass = "pt-16 md:pt-32 pb-8 md:pb-16" %}
{% else %}
    {% set spacingClass = "py-16 md:py-32" %}
{% endif %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<section x-data="{ visible: false }" x-intersect.once.margin.0px.0px.-100px.0px="visible = true" class="bg-primary relative overflow-hidden" id="{{id}}">
    <div class="container mx-auto px-4 lg:px-8 {{ spacingClass }} relative">
        {% if title %}
            <h2 class="text-white text-center mb-4"
                style="opacity: 0; transform: translateY(40px);"
                :style="`opacity: ${visible ? 1 : 0}; transform: translateY(${visible ? 0 : 40}px); transition: opacity 0.5s ease-out, transform 0.5s ease-out;`">{{ title|striptags|raw }}</h2>
        {% endif %}

        {% if description %}
            <p class="text-white text-center max-w-3xl mx-auto mb-12"
                style="opacity: 0; transform: translateY(40px);"
                :style="`opacity: ${visible ? 1 : 0}; transform: translateY(${visible ? 0 : 40}px); transition: opacity 0.5s 100ms ease-out, transform 0.5s 100ms ease-out;`">{{ description|striptags }}</p>
        {% endif %}

        {% if blocks|length %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for block in blocks %}
                    <div class="relative md:grid md:grid-rows-subgrid md:row-span-2 md:gap-y-0">

                        {% if loop.first or loop.last %}
                            {# Shapes #}
                            <div class="flex gap-6 flex-col absolute {% if loop.first %} -top-[40px] -left-[80px] {% else %} -bottom-[40px] -right-[80px] {% endif %}">
                                {% for i in 1..6 %}
                                    <div class="flex gap-6">
                                        {% for i in 1..6 %}
                                            {% include "/shapes/logo.twig" with { customClass: 'w-3 h-3 shrink-0', customColor: '#B7E5BA' } %}
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {# Card #}
                        <div class="bg-card-border rounded p-12 h-full md:grid md:grid-rows-subgrid md:row-span-2 md:gap-y-0"
                            style="opacity: 0; transform: translateY(40px);"
                            :style="`opacity: ${visible ? 1 : 0}; transform: translateY(${visible ? 0 : 40}px); transition: opacity 0.5s {{ loop.index * 100 }}ms ease-out, transform 0.5s {{ loop.index * 100 }}ms ease-out;`">
                            {# Title row — always rendered so every card shares the same subgrid row #}
                            <div class="flex items-center gap-3 mb-4">
                                {% if block.commonIcon ?? null %}
                                    <i data-lucide="{{ block.commonIcon }}" class="w-6 h-6 text-primary-mint shrink-0" stroke-width="2.5"></i>
                                {% endif %}
                                {% if block.commonTitle ?? null %}
                                    <h4 class="font-bold">{{ block.commonTitle|striptags|raw }}</h4>
                                {% endif %}
                            </div>

                            {# Description row #}
                            <div class="s-mainfeatures">
                                {% if block.commonDescription ?? null %}
                                    {{ block.commonDescription|raw }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
