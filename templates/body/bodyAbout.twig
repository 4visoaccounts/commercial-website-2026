{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set id = data.commonId ?? "" %}
{% set title = data.commonTitle ?? "" %}
{% set description = data.commonDescription ?? "" %}
{% set link = data.commonLink ?? null %}
{% set teammembers = data.commonTeammembers.all() ?? [] %}
{% set spacing = data.commonSpacing ?? "default" %}
{% if spacing == "small" %}
    {% set spacingClass = "py-8 md:py-16" %}
{% elseif spacing == "smallTopDefaultBottom" %}
    {% set spacingClass = "pt-8 md:pt-16 pb-16 md:pb-32" %}
{% elseif spacing == "smallBottomDefaultTop" %}
    {% set spacingClass = "pt-16 md:pt-32 pb-8 md:pb-16" %}
{% else %}
    {% set spacingClass = "py-16 md:py-32" %}
{% endif %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<section x-data="{ visible: false }" x-intersect.once.margin.0px.0px.-100px.0px="visible = true" class="{{ spacingClass }} bg-no-repeat relative" style="background-image: url('/assets/gradient.png'); background-size: 200% 100%; background-position: center;" id="{{id}}">
    {# Repeating logo pattern #}
    <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-10 flex flex-wrap content-start gap-8 p-6">
        {% for i in 1..2000 %}
            {% include "/shapes/logo.twig" with { customClass: 'w-2 h-2 shrink-0' } %}
        {% endfor %}
    </div>
    <div class="container mx-auto px-4 lg:px-8 xl:px-20 relative">
        {# Top: title left, description right #}
        {% if title or description or link %}
            <div class="flex flex-col md:flex-row gap-12 mb-20"
                style="opacity: 0; transform: translateY(40px);"
                :style="`opacity: ${visible ? 1 : 0}; transform: translateY(${visible ? 0 : 40}px); transition: opacity 0.5s ease-out, transform 0.5s ease-out;`">
                {% if title or link %}
                    <div class="w-full md:w-1/3 flex items-center gap-4">
                        {% if title %}
                            <h2 class="text-peach text-6xl">{{ title|striptags|raw }}</h2>
                        {% endif %}
                        {% if link %}
                            <a href="{{ link.url ?? '#' }}" class="inline-block no-underline text-white hover:text-peach transition-colors" target="_blank" rel="noopener" aria-label="LinkedIn">
                                {% include "/shapes/linkedin.twig" with { customClass: 'w-8 h-auto shrink-0' } %}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                {% if description %}
                    <div class="w-full md:w-2/3">
                        <p class="text-white text-xl leading-[1.7]">{{ description|striptags('<strong><br><br/>')|raw }}</p>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# Team members grid #}
        {% if teammembers|length %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:px-8"
                style="opacity: 0; transform: translateY(40px);"
                :style="`opacity: ${visible ? 1 : 0}; transform: translateY(${visible ? 0 : 40}px); transition: opacity 0.5s 150ms ease-out, transform 0.5s 150ms ease-out;`">
                {% for member in teammembers %}
                    {% set photo = member.commonAsset.one() ?? null %}
                    {% set memberLink = member.commonLink ?? null %}

                    <div class="relative rounded overflow-hidden aspect-[300/350]{% if photo %} bg-cover bg-center{% endif %}"{% if photo %} style="background-image: url('{{ photo.getUrl({ width: 600, format: 'webp', quality: 80 }) }}')"{% endif %}>

                        {# Gradient overlay #}
                        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/70 to-transparent"></div>

                        {# Text overlay #}
                        <div class="absolute inset-x-0 bottom-0 p-6 flex items-end justify-between gap-4">
                            <div class="min-w-0">
                                <span class="block text-white font-bold text-2xl leading-tight">{{ member.commonTitle|striptags }}</span>
                                {% if member.commonDescription ?? null %}
                                    <p class="text-white text-base mt-1">{{ member.commonDescription|striptags|raw }}</p>
                                {% endif %}
                            </div>
                            {% if memberLink %}
                                <a href="{{ memberLink.url ?? '#' }}" class="no-underline shrink-0 text-white hover:text-primary-lightest-green transition-colors" target="_blank" rel="noopener" aria-label="{{ member.commonTitle|striptags }} on LinkedIn">
                                    {% include "/shapes/linkedin.twig" with { customClass: 'w-6 h-auto' } %}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
