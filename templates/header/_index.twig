{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set hideMenu = hideMenu is defined ? hideMenu : false %}
{% set links = header.commonLinks.all() ?? [] %}

{# ========================================================================== #}
{# Header Index #}
{# ========================================================================== #}

{# Secondary row — desktop only, scrolls away with page #}
<div class="hidden md:block bg-white relative z-40">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="flex items-center justify-between py-4 text-sm">
            {# Left side — support + sales #}
            <div class="flex items-center gap-6">
                <a href="/customer-support" class="text-dark no-underline hover:text-primary transition-colors inline-flex items-center gap-1.5">
                    <i class="ph ph-headset"></i>
                    Customer Support
                </a>
                <a href="/contact-sales" class="text-dark no-underline hover:text-primary transition-colors inline-flex items-center gap-1.5">
                    <i class="ph ph-phone"></i>
                    Contact Sales
                </a>
            </div>

            {# Right side — login #}
            <div class="flex items-center gap-4">
                <a href="/login" class="text-dark no-underline hover:text-primary transition-colors inline-flex items-center gap-1.5">
                    <i class="ph ph-sign-in"></i>
                    Login
                </a>
            </div>
        </div>
    </div>
</div>

{# Primary row — sticks to top once secondary scrolls off #}
<header x-data="{ open: false }" class="sticky top-0 z-50 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
        <nav class="flex items-center justify-between py-4">
            {# Logo #}
            <a href="/" class="no-underline">
                {% include "/logos/logo-green.twig" with { customClass: 'h-10'} %}
            </a>

            {# Desktop navigation #}
            {% if not hideMenu and links|length %}
                <div class="hidden md:flex items-center gap-8">
                    {% for item in links %}
                        {% set link = item.commonLink ?? null %}
                        {% if link %}
                            {% if loop.last %}
                                {% include 'components/button' with {
                                    href: link.url ?? '#',
                                    text: link.text ?? '',
                                    variant: 'primary',
                                } %}
                            {% else %}
                                <a href="{{ link.url ?? '#' }}" class="text-dark no-underline text-[16px] font-medium hover:text-primary transition-colors">
                                    {{ link.text }}
                                </a>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {# Mobile hamburger #}
            <button @click="open = !open" class="md:hidden text-dark" aria-label="Toggle menu">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </nav>
    </div>

    {# Mobile navigation — full screen overlay #}
    {% if not hideMenu and links|length %}
        <div x-show="open" x-cloak
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-50 bg-primary md:hidden flex flex-col">

            {# Top bar with logo + close #}
            <div class="container mx-auto px-4 lg:px-8">
                <div class="flex items-center justify-between py-6">
                    <a href="/" class="no-underline">
                        {% include "/logos/logo.twig" with { customClass: 'h-10'} %}
                    </a>
                    <button @click="open = false" class="text-white" aria-label="Close menu">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>

            {# Centered links #}
            <div class="flex-1 flex flex-col items-center justify-center gap-10">
                {% for item in links %}
                    {% set link = item.commonLink ?? null %}
                    {% if link %}
                        {% if loop.last %}
                            {% include 'components/button' with {
                                href: link.url ?? '#',
                                text: link.text ?? '',
                                variant: 'white',
                            } %}
                        {% else %}
                            <a href="{{ link.url ?? '#' }}" @click="open = false"
                               class="text-white no-underline text-[28px] font-medium hover:text-peach transition-colors">
                                {{ link.text }}
                            </a>
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {# Secondary links — surfaced on mobile #}
                <div class="flex flex-col items-center gap-6 pt-6 mt-2 border-t border-white/20 w-40">
                    <a href="/customer-support" @click="open = false"
                       class="text-white no-underline text-[18px] font-medium hover:text-peach transition-colors">
                        Customer Support
                    </a>
                    <a href="/contact-sales" @click="open = false"
                       class="text-white no-underline text-[18px] font-medium hover:text-peach transition-colors">
                        Contact Sales
                    </a>
                    <a href="/login" @click="open = false"
                       class="text-white no-underline text-[18px] font-medium hover:text-peach transition-colors inline-flex items-center gap-2">
                        <i class="ph ph-sign-in"></i>
                        Login
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
</header>
